#include <stdio.h>
#include <ctype.h>
int gcd(int a, int b)
{
    while(b != 0)
    {
        int t = a % b;
        a = b;
        b = t;
    }
    return a;
}
int main()
{
    char text[200];
    int a, b, i, p;
    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);
    printf("Enter a and b: ");
    scanf("%d %d", &a, &b);
    if(gcd(a, 26) != 1)
    {
        printf("Invalid value of a");
        return 0;
    }
    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha(text[i]))
        {
            p = toupper(text[i]) - 'A';
            p = (a * p + b) % 26;
            if(isupper(text[i]))
                text[i] = p + 'A';
            else
                text[i] = p + 'a';
        }
    }
    printf("Ciphertext: %s", text);
    return 0;
}
