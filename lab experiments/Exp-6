#include <stdio.h>
#include <string.h>
#include <ctype.h>
int gcd(int a, int b) {
    return b == 0 ? a : gcd(b, a % b);
}
int main() {
    char c[500];
    int i, a, b, inv = -1, x;
    printf("Enter ciphertext: ");
    scanf(" %499[^\n]", c);
    for (a = 1; a < 26; a++) {
        if (gcd(a, 26) == 1 &&
            (a * (19 - 4) - (20 - 1)) % 26 == 0)
            break;
    }
    b = (1 - a * 4 + 26 * 26) % 26;
    for (i = 1; i < 26; i++)
        if ((a * i) % 26 == 1) {
            inv = i;
            break;
        }
    printf("Key a = %d, b = %d\n", a, b);
    printf("Decrypted text: ");
    for (i = 0; c[i]; i++) {
        if (isalpha((unsigned char)c[i])) {
            x = toupper((unsigned char)c[i]) - 'A';
            putchar((inv * (x - b + 26)) % 26 + 'A');
        } else {
            putchar(c[i]);
        }
    }
    printf("\n");
    return 0;
}
