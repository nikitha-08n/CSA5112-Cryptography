#include <stdio.h>
#include <string.h>
#include <ctype.h>
int main() {
    char text[100], key[27];
    int i, j;
    printf("Enter ciphertext: ");
    scanf("%99s", text);
    printf("Enter 26-letter encryption key: ");
    scanf("%26s", key);
    for (i = 0; text[i] != '\0'; i++) {
        char ch = toupper((unsigned char)text[i]);
        if (ch >= 'A' && ch <= 'Z') {
            for (j = 0; j < 26; j++) {
                if (toupper((unsigned char)key[j]) == ch)
                    break;
            }
            if (j < 26)
                text[i] = 'A' + j;
        }
    }
    printf("Decrypted text: %s\n", text);
    return 0;
}
