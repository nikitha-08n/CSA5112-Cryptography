#include <stdio.h>
#include <ctype.h>
int main()
{
    char str[100];
    int k, i;
    printf("Enter text: ");
    fgets(str, sizeof(str), stdin);
    printf("Enter key (1-25): ");
    scanf("%d", &k);
    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] >= 'A' && str[i] <= 'Z')
            str[i] = (str[i] - 'A' + k) % 26 + 'A';

        else if(str[i] >= 'a' && str[i] <= 'z')
            str[i] = (str[i] - 'a' + k) % 26 + 'a';
    }
    printf("Ciphertext: %s", str);
    return 0;
}
