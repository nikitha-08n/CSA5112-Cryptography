#include <stdio.h>
#include <string.h>
#include <ctype.h>
char matrix[5][5];
void createMatrix(char key[])
{
    int used[26] = {0};
    int i, j, k = 0;
    char c;
    used['J' - 'A'] = 1;
    for(i = 0; key[i] != '\0'; i++)
    {
        c = toupper(key[i]);
        if(c == 'J')
            c = 'I';
        if(c >= 'A' && c <= 'Z' && !used[c - 'A'])
        {
            matrix[k / 5][k % 5] = c;
            used[c - 'A'] = 1;
            k++;
        }
    }
    for(c = 'A'; c <= 'Z'; c++)
    {
        if(c == 'J')
            continue;
        if(!used[c - 'A'])
        {
            matrix[k / 5][k % 5] = c;
            used[c - 'A'] = 1;
            k++;
        }
    }
}
void findPosition(char c, int *r, int *col)
{
    int i, j;
    if(c == 'J')
        c = 'I';
    for(i = 0; i < 5; i++)
        for(j = 0; j < 5; j++)
            if(matrix[i][j] == c)
            {
                *r = i;
                *col = j;
                return;
            }
}
int main()
{
    char key[50], text[200];
    char p[200];
    int i, n = 0;
    int r1, c1, r2, c2;
    char a, b;
    printf("Enter keyword: ");
    scanf("%s", key);
    getchar();
    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);
    createMatrix(key);
    printf("\nPlayfair Matrix:\n");
    for(i = 0; i < 5; i++)
    {
        for(int j = 0; j < 5; j++)
            printf("%c ", matrix[i][j]);
        printf("\n");
    }
    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha(text[i]))
        {
            p[n++] = toupper(text[i]);
            if(p[n-1] == 'J')
                p[n-1] = 'I';
        }
    }
    if(n % 2 != 0)
        p[n++] = 'X';
    printf("\nCiphertext: ");
    for(i = 0; i < n; i += 2)
    {
        a = p[i];
        b = p[i + 1];
        findPosition(a, &r1, &c1);
        findPosition(b, &r2, &c2);
        if(r1 == r2)
        {
            printf("%c%c",
                   matrix[r1][(c1 + 1) % 5],
                   matrix[r2][(c2 + 1) % 5]);
        }
        else if(c1 == c2)
        {
            printf("%c%c",
                   matrix[(r1 + 1) % 5][c1],
                   matrix[(r2 + 1) % 5][c2]);
        }
        else
        {
            printf("%c%c",
                   matrix[r1][c2],
                   matrix[r2][c1]);
        }
    }
    return 0;
}
