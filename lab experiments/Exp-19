#include <stdio.h>
#include <string.h>
#include <openssl/evp.h>
#include <openssl/provider.h>
#include <openssl/err.h>

int main(void) {
    OSSL_PROVIDER *legacy = OSSL_PROVIDER_load(NULL, "legacy");
    OSSL_PROVIDER *deflt = OSSL_PROVIDER_load(NULL, "default");
    EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();

    unsigned char key[24] = "123456789012345678901234";
    unsigned char iv[8] = "12345678";
    unsigned char input[128];
    unsigned char output[160];
    int len = 0, total = 0;

    if (!legacy || !deflt || !ctx) {
        printf("OpenSSL provider initialization failed.\n");
        goto cleanup;
    }

    printf("Enter plaintext: ");
    if (!fgets((char *)input, sizeof(input), stdin))
        goto cleanup;

    input[strcspn((char *)input, "\n")] = '\0';

    if (EVP_EncryptInit_ex(ctx, EVP_des_ede3_cbc(), NULL, key, iv) != 1) {
        printf("Triple DES initialization failed.\n");
        ERR_print_errors_fp(stderr);
        goto cleanup;
    }

    if (EVP_EncryptUpdate(ctx, output, &len, input,
                          (int)strlen((char *)input)) != 1) {
        printf("Encryption failed.\n");
        ERR_print_errors_fp(stderr);
        goto cleanup;
    }
    total = len;

    if (EVP_EncryptFinal_ex(ctx, output + total, &len) != 1) {
        printf("Encryption finalization failed.\n");
        ERR_print_errors_fp(stderr);
        goto cleanup;
    }
    total += len;

    printf("Ciphertext: ");
    for (int i = 0; i < total; i++)
        printf("%02X", output[i]);
    printf("\n");

cleanup:
    EVP_CIPHER_CTX_free(ctx);
    OSSL_PROVIDER_unload(legacy);
    OSSL_PROVIDER_unload(deflt);
    return 0;
}
